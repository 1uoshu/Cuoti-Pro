# Copy to .env before deployment. The built-in Agent reuses these OPENAI_*
# settings; leave AGENT_API_* empty unless an optional external Agent is used.
OPENAI_API_KEY=your-openai-compatible-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

JWT_SECRET_KEY=replace-with-a-long-random-secret
MYSQL_PASSWORD=replace-with-a-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-root-password
BACKEND_PORT=8000

AGENT_API_BASE_URL=
AGENT_API_KEY=
