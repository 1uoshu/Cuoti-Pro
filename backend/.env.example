APP_NAME=Smart Learning Agent API
APP_ENV=development
# Use the local MySQL80 service configured on this machine.
DATABASE_URL=mysql+pymysql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:3306/smart_learning_agent?charset=utf8mb4
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_HOURS=12
OPENAI_API_KEY=your-openai-compatible-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
# Must support image input for homework grading.
OPENAI_MODEL=gpt-4o
# External Agent service from docs/agent_api.json. The key is sent only as a
# standard Authorization: Bearer <JWT> header.
AGENT_API_BASE_URL=http://127.0.0.1:8010
AGENT_API_KEY=replace-with-agent-jwt
AGENT_API_TIMEOUT_SECONDS=120
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=10
CORS_ORIGINS=http://localhost:5173
STORAGE_DIR=storage
REVIEW_CONFIDENCE_THRESHOLD=0.85
# Keep true for a local fallback. Set false for environments managed by Alembic.
AUTO_CREATE_TABLES=true
PLUGIN_MODULES=app.plugins.example,app.plugins.mastery_tracking,app.plugins.wrong_question_book,app.plugins.assignment_grading,app.plugins.layered_practice,app.plugins.learning_dashboard
